{
  "name": "translateit-tauri-desktop-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:app": "tauri dev",
    "build:frontend": "vite build",
    "typecheck": "node scripts/run_svelte_check_strict.mjs",
    "test:frontend-runtime": "node --experimental-strip-types --test \"scripts/tests/*.test.ts\"",
    "check:rust": "node scripts/validate_rust_manifest_preflight.mjs",
    "check:tauri-rust-local": "node scripts/run_local_tauri_compile_check.mjs",
    "preflight:release-payload": "node scripts/validate_release_model_revisions.mjs && node scripts/validate_release_payload.mjs",
    "preflight:tauri-package": "node scripts/validate_tauri_package_preflight.mjs && node scripts/validate_release_package_contract.mjs",
    "validate:bridge-contract": "node scripts/validate_bridge_contract.mjs",
    "validate:virtual-route": "node scripts/validate_virtual_route_contract.mjs",
    "validate:source-size": "node scripts/validate_source_size_budget.mjs",
    "validate:reachability": "node scripts/validate_frontend_reachability.mjs",
    "validate:source-contracts": "npm run validate:bridge-contract && npm run validate:virtual-route && npm run validate:source-size && npm run validate:reachability && npm run validate:dependency-usage && npm run validate:rust-dependency-usage && npm run check:rust && npm run preflight:tauri-package",
    "validate:quick": "npm run validate:source-contracts && npm run typecheck && npm run test:frontend-runtime",
    "validate:dependency-usage": "node scripts/validate_dependency_usage.mjs",
    "validate:rust-dependency-usage": "node scripts/validate_rust_dependency_usage.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.26.0",
    "@tauri-apps/api": "^2.0.0",
    "bits-ui": "^2.18.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.0.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
